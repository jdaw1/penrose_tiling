/NumThins 2355 def
/NumThins_0T4F 530 def
/NumThins_1T3F 1740 def
/NumPathsClosed 394 def
/NumPathsOpen 60 def
/NumPathsStats 11 def
/BoundingPathNumVertices 330 def
/XMin -43.728355336 def
/XMax 43.728355336 def
/YMin -37.506577809 def
/YMax 45.978713764 def
/RadiusMax 45.978713764 def
/RadiusShortOpen 32.652475842 def
/DataAsOf (D:20260830135126) def
