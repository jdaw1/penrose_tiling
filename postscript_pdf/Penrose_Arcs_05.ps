PaperMatrix setmatrix  StrokeMulti
% Functions taken from https://github.com/jdaw1/placemat/blob/main/PostScript/placemat.ps
/ToString
{
	1 dict begin  dup type cvlit /Type exch def
	1 {
		Type /integertype  eq {11 string cvs exit ( ) Concatenate} if
		Type /realtype     eq {16 string cvs exit ( ) Concatenate} if
		Type /nametype     eq {dup length string cvs exit} if
		Type /stringtype   eq {exit} if
		Type /booleantype  eq {5 string cvs exit} if
		Type /operatortype eq {127 string cvs exit} if
		Type /marktype     eq {pop (mark) exit} if
		Type /nulltype     eq {pop (null) exit} if
		pop (-- not handled --)  % fall-back
	} repeat  end
} bind def  % /ToString

/Concatenate {2 copy length exch length dup 3 1 roll add string dup dup 5 3 roll exch putinterval 3 -1 roll 0 exch putinterval} bind def

% mark string|number|other ... string|number|other  ConcatenateToMark  string
/ConcatenateToMark
{
	4 dict begin
	counttomark /ctm exch def  /n 0 def
	ctm {ToString  dup length n add /n exch def  ctm 1 roll} repeat
	/p 0 def  /s n 65535 2 copy gt {exch} if pop string def
	ctm  -1  0
	{
		dup 0 gt
		{
			-1 roll   dup length p add  65532 le
				{s exch p exch dup length p add /p exch def putinterval}
				{s exch p exch 0 65532 p sub getinterval putinterval  s 65532 (...) putinterval  cleartomark  s  exit}
			ifelse  % too long
		} {pop pop s} ifelse
	} for
	end
} bind def  % /ConcatenateToMark




% Computes the path of a glyph, with the charpath-style boolean flag, moving the currentpoint as if after a show.
/GlyphPathMoveto
{
	2 dict begin
	/bln exch def
	/GlyphNameThis exch def
	currentfont
	currentfont length dict begin
	currentfont {1 index /FID ne {def} {pop pop} ifelse} forall
	/Encoding [ 256 {/.notdef} repeat ] def
	Encoding 97 GlyphNameThis put  % ASCII a = 97
	currentdict
	end
	/TemporaryFont exch definefont pop
	/TemporaryFont 1 selectfont
	currentpoint exch (a) stringwidth pop add exch
	(a) bln charpath % (a) has been redefined
	moveto
	setfont
	/TemporaryFont undefinefont
	end
} bind def  % /GlyphPathMoveto

% http://groups.google.com/g/comp.lang.postscript/c/hZmiLPonDl8  "Possible bug in Mac Distiller's charpath?", 16 Feb 2008
% There is a current point.
% CompoundString bool  CharPathGeneral  -
/CharPathGeneral
{
	2 dict begin
	/bln exch def
	/param exch def
	1 {
		/param load xcheck {[ param ]     bln CharPathGeneral         exit} if  % executable
		param type /arraytype  eq {param {bln CharPathGeneral} forall exit} if  % array
		param type /stringtype eq {param  bln                charpath exit} if  % string
		param type /nametype   eq {param  bln GlyphPathMoveto         exit} if  % glyph
		(
CharPathGeneral: type error. Continuing.) = param == (
) =
	} repeat  % 1
	end
} bind def  % /CharPathGeneral

/StringWidthGeneral {gsave nulldevice 0 0 moveto true CharPathGeneral currentpoint pop grestore} bind def

% FontName FontSize CompoundString  ShowOutlined  -
/ShowOutlined
{
	3 dict begin
	/CompoundString exch def  /FontSize exch def  /FontName exch def
	FontName FontSize selectfont
	CompoundString true CharPathGeneral
	gsave FontSize 8 div setlinewidth 1 setgray 1 setlinejoin stroke grestore 0 setgray fill
	end
} bind def  % /ShowOutlined


() =
/NumRhombi NumFats NumThins add def[/TilingId /DataAsOf /NumFats /NumThins /NumRhombi /EdgeLength  /XMin /XMax /YMin /YMax  /ToPaint_XMin /ToPaint_XMax /ToPaint_YMin /ToPaint_YMax]
{
	dup 12 string cvs ( = ) Concatenate  exch load
	dup type /stringtype eq {(") exch (") Concatenate Concatenate} {16 string cvs} ifelse
	Concatenate =
} forall
mark (\nPageWidth = ) PageWidth  (pt = ) PageWidth 72 div  (" = ) PageWidth  127 mul 360 div (mm) ConcatenateToMark =
mark   (PageHeight = ) PageHeight (pt = ) PageHeight 72 div (" = ) PageHeight 127 mul 360 div (mm) ConcatenateToMark =
mark (T, B, L, and R margins each = ) Margin (pt = ) Margin 72 div (" = ) Margin 127 mul 360 div (mm) ConcatenateToMark =
mark (ScaleFactor = ) ScaleFactor ConcatenateToMark =
mark (On paper, length of an edge is ) EdgeLength ScaleFactor mul (pt = ) 1 index 72 div (" = 1"/) 1 2 index div ( = ) 5 index 127 mul 360 div (mm = 1mm/) 1 2 index div ConcatenateToMark =


(\n\nPathStats:\n\nPathClosed\tPathLength\tNumPaths\tMaxNumThisFats\tMaxNumDeepFats\tMaxNumThisThins\tMaxNumDeepThins\tMaxNumThisFats_Num\tMaxNumDeepFats_Num\tMaxNumThisThins_Num\tMaxNumDeepThins_Num\tRadiusMinMin_EdgeLengths\tRadiusMaxMax_EdgeLengths\tWidthMax_EdgeLengths\tHeightMax_EdgeLengths) =


/FontName /Helvetica def



false  % Boolean: paint gridlines?
{
	14 dict begin

/FontName /Helvetica-Bold def
	/SizeX Actual_XMax Actual_XMin sub def
	/SizeY Actual_YMax Actual_YMin sub def
	/GridStepX
	1 {
		SizeX   16 le {   1 exit} if
		SizeX   32 le {   2 exit} if
		SizeX   80 le {   5 exit} if
		SizeX  160 le {  10 exit} if
		SizeX  320 le {  20 exit} if
		SizeX  800 le {  50 exit} if
		SizeX 1600 le { 100 exit} if
		SizeX 3200 le { 500 exit} if
		SizeX 8000 le {1000 exit} if
		SixeX log 0.3 sub floor cvi 10 exch exp exit
	} repeat def  % 1, /GridStepX
	/GridStepY
	1 {
		SizeY   16 le {   1 exit} if
		SizeY   32 le {   2 exit} if
		SizeY   80 le {   5 exit} if
		SizeY  160 le {  10 exit} if
		SizeY  320 le {  20 exit} if
		SizeY  800 le {  50 exit} if
		SizeY 1600 le { 100 exit} if
		SizeY 3200 le { 500 exit} if
		SizeY 8000 le {1000 exit} if
		SixeY log 0.3 sub floor cvi 10 exch exp exit
	} repeat def  % 1, /GridStepY
	/StartX  Actual_XMin GridStepX div ceiling cvi GridStepX mul  def
	/StartY  Actual_YMin GridStepY div ceiling cvi GridStepY mul  def

	//TileMatrix setmatrix

	StartY  GridStepY  Actual_YMax
	{
		/GridVal exch def
		Actual_XMin GridVal moveto  Actual_XMax GridVal lineto
	} for  % GridVal, horizontal lines
	StartX  GridStepX  Actual_XMax
	{
		/GridVal exch def
		GridVal Actual_YMin moveto  GridVal Actual_YMax lineto
	} for  % GridVal, vertical lines
	matrix currentmatrix  PaperMatrix setmatrix
	gsave 0.72 setlinewidth 1 setgray 1 setlinecap stroke grestore
	0.24 setlinewidth 0 setgray 0 setlinecap stroke
	setmatrix

	/FontSize Actual_YMax Actual_YMin sub 60 div def
	FontName FontSize selectfont
	StartY  GridStepY  Actual_YMax
	{
		/GridVal exch def
		Actual_XMax  GridVal FontSize 0.3 mul sub  moveto
		FontName FontSize
		GridVal 0 lt {[/minus GridVal abs 16 string cvs]} {GridVal 16 string cvs} ifelse
		dup StringWidthGeneral neg 0 rmoveto  ShowOutlined
	} for  % GridVal, y labels
	StartX  GridStepX  Actual_XMax
	{
		/GridVal exch def
		GridVal  Actual_YMin  moveto
		FontName FontSize
		GridVal 0 lt {[/minus GridVal abs 16 string cvs]} {GridVal 16 string cvs} ifelse
		dup StringWidthGeneral -2 div 0 rmoveto  ShowOutlined
	} for  % GridVal, x labels
	end
} if  % Paint gridlines?



showpage

(\n\n) =
count              (      = count: this really should be 0\n)   dup 0  4 -1 roll  6 string cvs  putinterval
countdictstack     (      = countdictstack: this should be 3\n) dup 0  4 -1 roll  6 string cvs  putinterval  Concatenate =
count 0 gt {(+pstack) = pstack (-pstack) =} if

{countdictstack 3 gt {8 {() =} repeat currentdict {exch == =} forall end} {exit} ifelse} bind loop  % Final debugging
