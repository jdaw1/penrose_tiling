			dup  23939  << /RhId 23939  /WantedPS true  /Physique 36  /Xn -0.527864045  /Yn -7.648940958  /Xs -0.562305899  /Ys -7.673964429  /Xe -0.506577809  /Ye -7.714453257  /Xw -0.583592135  /Yw -7.60845213  /AngDeg 36  /Neighbours [ << /Edge /SW  /RhId 23940  /NNN 2 >> << /Edge /SE  /RhId 14555  /NNN 3 >> << /Edge /NE  /RhId 6977  /NNN 0 >> << /Edge /NW  /RhId 6978  /NNN 1 >> ] >>  put
