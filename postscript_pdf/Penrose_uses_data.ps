/DOCINFO pdfmark

/DeBugLevel 65535 def  % Smaller numbers are smaller more-core routines.

/mmTileEdge 151 def

/WantedMinX -999 def  /WantedMinY -999 def  /WantedMaxX +999 def  /WantedMaxY +999 def

% Physique PathLength PathClosed Pointy  SetColour_Many  Bool-true=fill-false=newpath
% Assumes fill'able path exists, which might be a rhombus, or arcs.
/SetColour_Many
{
	4 dict begin
	/Pointy exch def   /PathClosed exch def   /PathLength exch def   /Physique exch def
	//false
	1 {
		72 Physique eq
		{
			PathClosed
			{
				% Closed ==> 5 5 15 25 55 105 215 425 855 1705 3415 6825 13655 27305 54615 ... ([n-1] + 2*[n-2])
				PathLength 5 eq Pointy and {0.6 1   0.6 setrgbcolor pop //true exit} if  % Very light green
				PathLength   15  eq        {0   0.5 0   setrgbcolor pop //true exit} if  % Dark green
				PathLength   25  eq        {0   0   0.6 setrgbcolor pop //true exit} if  % Dark blue
				PathLength   55  eq        {0   0   1   setrgbcolor pop //true exit} if  % Blue
				PathLength  105  eq        {1   0.4 1   setrgbcolor pop //true exit} if  % Pink
				PathLength  215  eq        {0.5 0   0   setrgbcolor pop //true exit} if  % Maroon
				PathLength  425  eq        {0.5         setgray     pop //true exit} if  % Mid grey
				PathLength  855  eq        {0.25        setgray     pop //true exit} if  % Dark grey
				PathLength 1705  eq        {1   0.4 0   setrgbcolor pop //true exit} if  % Orange
				PathLength 3415 ge         {0           setgray     pop //true exit} if  % Black, ge ==> very long closed paths.
			}{
				PathLength 1000 ge         {1   0   0   setrgbcolor pop //true exit} if  % Bright red
			} ifelse  % PathClosed
		}{
			                               0.8         setgray     pop //true exit      % Thin ==> Grey
		} ifelse  % Physique
		exit  % default
	} repeat  % 1, exit'able
	end
} bind def  % /SetColour_Many

% Physique PathLength PathClosed Pointy  SetColour_Many  Bool-true=fill-false=newpath
% Assumes fill'able path exists, which might be a rhombus, or arcs.
/SetColour_Few
{
	4 dict begin
	/Pointy exch def   /PathClosed exch def   /PathLength exch def   /Physique exch def
	//false
	1 {
		72 Physique eq
		{
			PathClosed
			{
				% Closed ==> 5 5 15 25 55 105 215 425 855 1705 3415 ... ([n-1] + 2*[n-2])
				PathLength   15  eq                  {0 1   1 0.25 setcmykcolor pop //true exit} if  % Green
				PathLength   25  eq                  {1 0.7 0 0.4  setcmykcolor pop //true exit} if  % Dark blue
			} if  % PathClosed
		} if  % Physique
		exit  % default
	} repeat  % 1, exit'able
	end
} bind def  % /SetColour_Few




/Tilings [

<<
	% Concatenate from http://github.com/jdaw1/placemat/blob/main/PostScript/placemat.ps, simplified
	/Concatenate {2 copy length exch length dup 3 1 roll add string dup dup 5 3 roll exch putinterval 3 -1 roll 0 exch putinterval} bind
	/usertimeStart usertime
>> begin

(At usertime=) usertimeStart 12 string cvs Concatenate (, starting interpretation of Tilings) Concatenate = flush



