false   SeedType /Round_5 eq and  RadiusShortOpen 0 gt and  % Boolean: paint circle excluding fats in short open paths
{
	TileMatrix setmatrix   0 30 330 {/ang exch def  0  0  RadiusShortOpen  ang  dup 30 add  arc} for  % 30 degree pieces for pointless accuracy.
	PaperMatrix setmatrix  1 setlinejoin
	gsave 3 setlinewidth 1 setgray stroke grestore
	1 setlinewidth 0 setgray stroke
} if  % circle bounding interesting well-populated rhombii


false  % Boolean: paint gridlines?
{
	14 dict begin

	/SizeX Actual_XMax Actual_XMin sub def
	/SizeY Actual_YMax Actual_YMin sub def
	/GridStepX
	1 {
		SizeX   16 le {   1 exit} if
		SizeX   32 le {   2 exit} if
		SizeX   80 le {   5 exit} if
		SizeX  160 le {  10 exit} if
		SizeX  320 le {  20 exit} if
		SizeX  800 le {  50 exit} if
		SizeX 1600 le { 100 exit} if
		SizeX 3200 le { 500 exit} if
		SizeX 8000 le {1000 exit} if
		SixeX log 0.3 sub floor cvi 10 exch exp exit
	} repeat def  % 1, /GridStepX
	/GridStepY
	1 {
		SizeY   16 le {   1 exit} if
		SizeY   32 le {   2 exit} if
		SizeY   80 le {   5 exit} if
		SizeY  160 le {  10 exit} if
		SizeY  320 le {  20 exit} if
		SizeY  800 le {  50 exit} if
		SizeY 1600 le { 100 exit} if
		SizeY 3200 le { 500 exit} if
		SizeY 8000 le {1000 exit} if
		SixeY log 0.3 sub floor cvi 10 exch exp exit
	} repeat def  % 1, /GridStepY
	/StartX  Actual_XMin GridStepX div ceiling cvi GridStepX mul  def
	/StartY  Actual_YMin GridStepY div ceiling cvi GridStepY mul  def

	//TileMatrix setmatrix

	StartY  GridStepY  Actual_YMax
	{
		/GridVal exch def
		Actual_XMin GridVal moveto  Actual_XMax GridVal lineto
	} for  % GridVal, horizontal lines
	StartX  GridStepX  Actual_XMax
	{
		/GridVal exch def
		GridVal Actual_YMin moveto  GridVal Actual_YMax lineto
	} for  % GridVal, vertical lines
	matrix currentmatrix  PaperMatrix setmatrix
	gsave 0.72 setlinewidth 1 setgray 1 setlinecap stroke grestore
	0.24 setlinewidth 0 setgray 0 setlinecap stroke
	setmatrix

	/FontSize Actual_YMax Actual_YMin sub 60 div def
	FontName FontSize selectfont
	StartY  GridStepY  Actual_YMax
	{
		/GridVal exch def
		Actual_XMax  GridVal FontSize 0.3 mul sub  moveto
		FontName FontSize
		GridVal 0 lt {[/minus GridVal abs 16 string cvs]} {GridVal 16 string cvs} ifelse
		dup StringWidthGeneral neg 0 rmoveto  ShowOutlined
	} for  % GridVal, y labels
	StartX  GridStepX  Actual_XMax
	{
		/GridVal exch def
		GridVal  Actual_YMin  moveto
		FontName FontSize
		GridVal 0 lt {[/minus GridVal abs 16 string cvs]} {GridVal 16 string cvs} ifelse
		dup StringWidthGeneral -2 div 0 rmoveto  ShowOutlined
	} for  % GridVal, x labels
	end
} if  % Paint gridlines?


TilingId -9 eq  % Boolean: paint kitchen? Perhaps change "-9" to "9".
{
	4 dict begin

	/mmTileEdge 150.6 def  % Tile edges must have matching lengths. This is that length, in millimetres, allowing for grouting.

	% Going to do a translation, in TileSpace, in which a tile is of length EdgeLength = 1.
	% Almost certainly, you want to translate to a point within ToPaint_XMin etc.
	% This point is the origin, the zero point, for the drawing of the room.
	% Suggestion: make it the point from which physical tiling will start, so the point of certain tile alignment,
	% so allowing (small) changes in mmTileEdge to correctly adjust for mis-judgements of grouting thickness.
	TileMatrix setmatrix  -11.3 -21.8 translate
	EdgeLength mmTileEdge div dup scale  /KitchenMatrix matrix currentmatrix def

	false  % Boolean: identify zero location (advice: use to assist choice of it, then disable).
	{
		2 dict begin
		/FontSize 5 def
		KitchenMatrix setmatrix   mmTileEdge EdgeLength div dup scale   matrix currentmatrix
		[ 10000 6000 4000 3000 2000 1500 1000 600 400 300 200 150 100 60 40 30 20 15 10 6 4 3 2 1 0.01 ]
		dup
		{
			/U_p exch def
			U_p  Actual_XMax Actual_XMin sub  lt
			U_p  Actual_YMax Actual_YMin sub  lt   or
			{
				/V_p 0.666666 U_p mul def  /U_n U_p neg def  /V_n V_p neg def  % U, V; positive, negative
				U_p V_p moveto  U_p U_p  2 copy  V_p U_p  curveto
				V_n U_p lineto  U_n U_p  2 copy  U_n V_p  curveto
				U_n V_n lineto  U_n U_n  2 copy  V_n U_n  curveto
				V_p U_n lineto  U_p U_n  2 copy  U_p V_n  curveto closepath
			} if  % U_p <= page size
		} forall  % U_p
		PaperMatrix setmatrix gsave 1.44 setlinewidth 0.8 setgray stroke grestore 0.48 setlinewidth 0.2 setgray stroke
		{  % forall with fixed array, again
			/U exch def
			U Actual_XMax Actual_XMin sub lt   U Actual_YMax Actual_YMin sub lt   or   U 0.5 gt  and
			{
				dup setmatrix  U neg U moveto
				PaperMatrix setmatrix 0 FontSize -0.4 mul rmoveto
				U 20 string cvs  FontName FontSize 3 -1 roll  ShowOutlined
			} if  % U <= page size
		} forall  % U
		pop   end
	} if  % Test zero location

	% Room specified in the mm, per mmTileEdge.
	% The starting 'moveto' should ideally be to a point near 0,0; i.e., near the place chosen the previous paragraph.
	% Carefully measure room; carefully echo those measurements to this section. Start with a 'moveto', then better to use 'rlineto's.
	/KitchenRoomPath
	{
		% in mm
		    0      0  moveto
		-3735      0  rlineto
		    0   +320  rlineto
		 -190      0  rlineto
		    0   +305  rlineto
		 +225      0  rlineto
		    0  +5160  rlineto
		-2590      0  rlineto
		    0   -140  rlineto
		 -355      0  rlineto
		    0   -585  rlineto
		 -237      0  rlineto
		    0  -3587  rlineto
		 +237      0  rlineto
		    0  -1973  rlineto
		 -250      0  rlineto
		    0  -3370  rlineto
		 +250      0  rlineto
		    0   -845  rlineto
		+6500      0  rlineto
		    0   +475  rlineto
		 +215      0  rlineto
		    0  +3280  rlineto
		  -70      0  rlineto
		    0   +960  rlineto
		closepath
	} bind def  % /KitchenRoomPath

	/KitchenFurniturePath
	{
		% in mm
		-1380  -2050  moveto  % island
		    0   -650  rlineto
		-1000      0  rlineto
		    0   -220  rlineto
		-1600      0  rlineto
		    0  +1090  rlineto
		+1050      0  rlineto
		    0   -220  rlineto
		closepath

		-2030      0  moveto  % cupboard
		    0   -150  rlineto
		-1070      0  rlineto
		    0    150  rlineto

		-6645	 -500  moveto  % fridge box
		 +640      0  rlineto
		    0   +760  rlineto
		 -640      0  rlineto

		-6645  -4180  moveto  % cabinets
		 6715      0  rlineto
	} bind def  % /KitchenFurniturePath

	gsave
	[
		{3 setlinewidth  1 setgray  1 setlinejoin  0 setlinecap}  % setlinewidth in PaperMatrix, so in points
		{1 setlinewidth  0 setgray  0 setlinejoin  1 setlinecap}
	]
	{
		/KitchenFormatting exch def
		[ {KitchenRoomPath} {KitchenFurniturePath} ]
		{
			KitchenMatrix setmatrix   exec
			PaperMatrix setmatrix  KitchenFormatting  stroke
		}
		forall  % Paths
	} forall  % Formatting
	grestore
	end
} if  % Paint kitchen?


false   % Boolean: label orientation, do or don't?
{
	1 dict begin
	/FontSize 14 def

	PaperMatrix setmatrix   FontName FontSize selectfont

	FontName FontSize  [(Label at top: e.g., ) /quotedblleft (Garden) /quotedblright (.)]
	PageWidth 2 div  PageHeight Margin FontSize add sub  moveto   dup StringWidthGeneral -2 div 0 rmoveto   ShowOutlined

	FontName FontSize  [(Label at bottom: e.g., ) /quotedblleft (North) /quotedblright (.)]
	PageWidth 2 div  Margin  moveto   dup StringWidthGeneral -2 div 0 rmoveto   ShowOutlined

	FontName FontSize  [(Label at left: e.g., ) /quotedblleft (South) /quotedblright (.)]
	gsave
	Margin FontSize add  PageHeight 2 div translate 90 rotate
	0 0 moveto   dup StringWidthGeneral -2 div 0 rmoveto   ShowOutlined
	grestore

	FontName FontSize  [(Label at right: e.g., ) /quotedblleft (Street) /quotedblright (.)]
	gsave
	PageWidth Margin FontSize add sub  PageHeight 2 div translate -90 rotate
	0 0 moveto   dup StringWidthGeneral -2 div 0 rmoveto   ShowOutlined
	grestore

	end
} if   % Show label orientations?


false   % Boolean: decorative text, do or don't?
{
	7 dict begin
	PaperMatrix setmatrix
	/FontSize 16 def
	/X 0.52 PageWidth  mul def  % User changeable.
	/Y 0.96 PageHeight mul def  % User changeable.
	/LineHeight  FontSize  1.3 mul def  % User changeable.

	FontName FontSize selectfont   0 setgray
	/indent  % by longer of these two strings
		(Round 5)  StringWidthGeneral
		(Pointy 5) StringWidthGeneral  2 copy lt {exch} if pop
	def  % /indent

	% In TextLines, each item is an array,
	% each subarray containing strings, glyphs, or executables.
	/TextLines [
		[(Path colours:)]
		[ {indent  (Round 5) StringWidthGeneral sub 0 rmoveto}  (Round 5 = white with circle;)]
		[ {indent (Pointy 5) StringWidthGeneral sub 0 rmoveto} (Pointy 5 = pale green;)]
		[ {indent       (15) StringWidthGeneral sub 0 rmoveto}       (15 = dark green;)]
		[ {indent       (25) StringWidthGeneral sub 0 rmoveto}       (25 = dark blue;)]
		[ {indent       (55) StringWidthGeneral sub 0 rmoveto}       (55 = bright blue;)]
		[ {indent      (105) StringWidthGeneral sub 0 rmoveto}      (105 = pink;)]
		[ {indent      (215) StringWidthGeneral sub 0 rmoveto}      (215 = maroon;)]
		[ {indent      (425) StringWidthGeneral sub 0 rmoveto}      (425 = medium green;)]
		[ {indent     (1705) StringWidthGeneral sub 0 rmoveto}     (1705 = orange;)]
		[ {indent     (Open) StringWidthGeneral sub 0 rmoveto}     (Open = bright red.)]
		[]
		[(GitHub.com/jdaw1/penrose_tiling)]
		[(has code, including for this page.)]
		[]
		[/emdash ( J. D. A. Wiseman, August 2026)]
	] def  % /TextLines

	0  1  TextLines length 1 sub
	{
		/lineNum exch def
		X  Y lineNum  LineHeight mul sub  moveto
		FontName   FontSize   TextLines lineNum get   ShowOutlined
	} for  % lineNum
	end
} if  % Show decorative text?


showpage


mark  (\n\n\nNum rhombi painted:)
(  thin=) PaintedNumByType /thin 2 copy known {get} {pop pop 0} ifelse
(;  fat=) 0 PaintedNumByType {exch /thin ne {add} {pop} ifelse} forall
(.\n\nPainted fat rhombi by path type \(r_ound, p_ointy, c_losed, o_pen\):\n)
[ (r) (p) (c) (o) ]  % Partial sorting of this log output.
{
	/MetaType exch 0 get def
	//PaintedNumByType
	{
		1 index dup  /thin ne  exch
		12 string cvs 0 get MetaType eq  and
		{
			12 string cvs (=) exch (,  )
		} {pop pop} ifelse  % /thin ne, MetaType eq
	} forall  % PaintedNumByType
} forall  % MetaType
pop (.\n) ConcatenateToMark =

(\n\n) =
count              (      = count: this really should be 0\n)   dup 0  4 -1 roll  6 string cvs  putinterval
countdictstack     (      = countdictstack: this should be 3\n) dup 0  4 -1 roll  6 string cvs  putinterval  Concatenate =
count 0 gt {(+pstack) = pstack (-pstack) =} if

{countdictstack 3 gt {8 {() =} repeat currentdict {exch == =} forall end} {exit} ifelse} bind loop  % Final debugging
